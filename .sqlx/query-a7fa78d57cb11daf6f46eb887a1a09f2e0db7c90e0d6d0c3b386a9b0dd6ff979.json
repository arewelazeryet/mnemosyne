  "query": "\nSELECT\n    EXTRACT(EPOCH FROM inserted_at)::BIGINT AS \"timestamp!\",\n    stable,\n    lazer\nFROM measurements\nWHERE (stable + lazer) > 5000\nORDER BY (lazer::DOUBLE PRECISION / NULLIF((stable + lazer)::DOUBLE PRECISION, 0)) DESC,\n         inserted_at ASC\nLIMIT 1\n            ",
